# کلید API آنتروپیک خودت رو اینجا بذار (از https://console.anthropic.com بگیر)
ANTHROPIC_API_KEY=your_api_key_here

# کلید رایگان Gemini (از https://aistudio.google.com بگیر) — اختیاری، اگه می‌خوای از Gemini هم استفاده کنی
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# کلید رایگان Z.ai (از https://z.ai بگیر) — اختیاری، فقط برای بخش‌های متنی (مثل عنوان/هشتگ)، از عکس پشتیبانی نمی‌کند
ZAI_API_KEY=your_zai_api_key_here
ZAI_MODEL=glm-4.7-flash

# پورت اجرای سرور (اختیاری)
PORT=3000
